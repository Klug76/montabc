#include <winver.h>
#include "version.h"

1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION    APP_FILEVERSION
PRODUCTVERSION APP_FILEVERSION
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "montabc - window panel"
            VALUE "FileVersion",     "1.3.0.0"
            VALUE "ProductName",     "montabc"
            VALUE "ProductVersion",  "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
